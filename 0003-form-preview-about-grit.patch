+/* ---------- form preview (looks like the court form) ---------- */
+function esc(t){ return String(t).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
+function renderPaper(){
+  const v = id => (S.form[id] || '').trim();
+  let filled = 0, total = 0;
+  let h = `<div class="ph"><div><h1>APPLICATION FOR PROTECTION ORDER</h1><p class="sub">Section 4(1) of the Domestic Violence Act, 1998 (Act No. 116 of 1998)</p></div><img src="/grit-logo.png" alt="GRIT"></div>
+  <div class="note">DRAFT prepared with inFORMed. Not yet sworn. Take this draft to the clerk at a Magistrates\u2019 Court. The clerk will help you complete the official form, and you will sign it in front of a commissioner of oaths.</div>`;
+  if (S.mode === 'demo') h += '<p class="demo">DEMO: this application is about an invented person.</p>';
+  SECTIONS.forEach(sec => {
+    const fs = FIELDS.filter(f => f.s === sec.n);
+    if (sec.optional && !fs.some(f => v(f.id))) return;
+    h += `<h3>Section ${sec.n}: ${esc(sec.formTitle)}</h3>`;
+    if (sec.n === 5 && S.abuse.length){
+      const names = S.abuse.map(a => (ABUSE_TYPES.find(x => x.id === a) || {}).label).filter(Boolean);
+      h += `<p class="types">Types of domestic violence described: ${esc(names.join(', '))}</p>`;
+    }
+    fs.forEach(f => {
+      const val = v(f.id); total++; if (val) filled++;
+      if (f.type === 'check'){
+        const det = val && val.toLowerCase() !== 'requested' ? `<span class="det">${esc(val)}</span>` : '';
+        h += `<div class="ck"><span class="bx">${val ? '\u2715' : ''}</span><div>${esc(f.label)}${det}</div></div>`;
+      } else {
+        h += `<div class="row"><div class="lab">${esc(f.label)}</div><div class="val">${val ? esc(val) : '<span class="empty">Not filled in yet</span>'}</div></div>`;
+      }
+    });
+  });
+  h += `<div class="sig"><div>Deponent (person applying): ______________________________</div><div>Date: ______________</div></div>
+  <p class="foot">Prepared with inFORMed \u00b7 Powered by GRIT (Gender Rights in Tech)</p>`;
+  $('paper').innerHTML = h;
+  $('pvSum').textContent = filled ? `${filled} of ${total} parts filled in. You can change anything in the form panel, or keep talking to add more.` : 'Nothing has been filled in yet. Tell inFORMed what happened, and your application will fill in as you talk.';
+}
+function openPreview(){ closePanel(); if ($('genDlg').open) $('genDlg').close(); renderPaper(); $('pvDlg').showModal(); $('pvDlg').querySelector('.pv-scroll').scrollTop = 0; }
+['pvOpen1','pvOpen2','pvOpen3'].forEach(id => $(id).onclick = openPreview);
+$('pvClose').onclick = () => $('pvDlg').close();
+$('pvPdf').onclick = () => download('pdf', $('pvPdf')); $('pvWord').onclick = () => download('docx', $('pvWord'));
+$('pvPrint').onclick = () => {
+  const w = window.open('', '_blank'); if (!w) return;
+  w.document.write('<!doctype html><html><head><meta charset="utf-8"><title>Protection order application (draft)</title><style>' + [...document.styleSheets].map(ss => { try { return [...ss.cssRules].map(r => r.cssText).join('\n'); } catch(e){ return ''; } }).join('\n') + ' body{background:#fff} .paper{box-shadow:none;max-width:none}</style></head><body><div class="paper">' + $('paper').innerHTML + '</div></body></html>');
+  w.document.close(); w.onload = () => { w.focus(); w.print(); };
+};
+
